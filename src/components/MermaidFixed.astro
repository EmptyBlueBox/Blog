<script>
  import mermaid from 'mermaid'

  let render_queue = Promise.resolve()

  const render_mermaid = async () => {
    document.querySelectorAll<HTMLElement>('div[data-language="mermaid"]').forEach((block) => {
      const wrapper = document.createElement('div')
      wrapper.className = 'mermaid-diagram-wrapper'
      wrapper.dataset.code = block
        .querySelector('pre code')!
        .textContent!.trim()
        .replace(/^(graph|flowchart)\s+(TD|TB)/, '$1 LR')
        .replace(/^(graph|flowchart)(?!\s+(LR|RL|TB|TD))/, '$1 LR')
      wrapper.textContent = wrapper.dataset.code
      block.replaceWith(wrapper)
    })

    const dark = document.documentElement.classList.contains('dark')
    const wrappers = [...document.querySelectorAll<HTMLElement>('.mermaid-diagram-wrapper')].filter(
      (wrapper) => wrapper.dataset.theme !== String(dark)
    )
    if (!wrappers.length) return

    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      themeVariables: dark
        ? {
            background: '#161619',
            mainBkg: '#18181b',
            secondaryBkg: '#27272a',
            tertiaryBkg: '#161619',
            primaryColor: '#18181b',
            primaryTextColor: '#f4f4f5',
            primaryBorderColor: '#52525b',
            secondaryColor: '#27272a',
            tertiaryColor: '#161619',
            lineColor: '#a1a1aa',
            textColor: '#f4f4f5',
            edgeLabelBackground: '#18181b',
            clusterBkg: '#161619',
            clusterBorder: '#3f3f46'
          }
        : {
            background: '#fcfdfe',
            mainBkg: '#f6f7f8',
            secondaryBkg: '#eef1f3',
            tertiaryBkg: '#f6f7f8',
            primaryColor: '#f6f7f8',
            primaryTextColor: '#18181b',
            primaryBorderColor: '#71717a',
            secondaryColor: '#eef1f3',
            tertiaryColor: '#f6f7f8',
            lineColor: '#52525b',
            textColor: '#18181b',
            edgeLabelBackground: '#f6f7f8',
            clusterBkg: '#f8fafb',
            clusterBorder: '#d4d4d8'
          },
      flowchart: { htmlLabels: true, nodeSpacing: 30, rankSpacing: 40 }
    })

    wrappers.forEach((wrapper) => {
      wrapper.className = 'mermaid-diagram-wrapper mermaid'
      wrapper.removeAttribute('data-processed')
      wrapper.textContent = wrapper.dataset.code!
    })
    await mermaid.run({ nodes: wrappers })
    wrappers.forEach((wrapper) => {
      wrapper.dataset.theme = String(dark)
      wrapper.className = 'mermaid-diagram-wrapper is-rendered'
    })
  }

  const queue_mermaid = () => {
    render_queue = render_queue.then(render_mermaid)
  }

  document.addEventListener('astro:page-load', queue_mermaid)
  new MutationObserver(queue_mermaid).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  })
  queue_mermaid()
</script>

<style is:global>
  .mermaid-diagram-wrapper {
    margin: 1rem 0 0.5rem;
    padding: 0.75rem;
    border: 1px solid hsl(var(--border) / 0.6);
    border-radius: 0.75rem;
    background: transparent;
    text-align: center;
    max-width: 100%;
    overflow-x: auto;
    line-height: 1;
    min-height: 8rem;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      background-color 0.3s ease;
  }

  .mermaid-diagram-wrapper.is-rendered {
    min-height: 0;
  }

  .mermaid-diagram-wrapper.mermaid {
    white-space: pre-wrap;
  }

  .mermaid-diagram-wrapper svg {
    width: auto !important;
    max-width: none !important;
    height: auto;
    display: block;
    margin: 0 auto;
    vertical-align: top;
  }

  .mermaid-diagram-wrapper svg text {
    font-size: 12px !important;
    font-weight: normal !important;
  }
</style>
