<script>
  let render_id = 0
  let mermaid_module: typeof import('mermaid').default | undefined

  const render_mermaid = async () => {
    document.querySelectorAll<HTMLElement>('div[data-language="mermaid"]').forEach((block) => {
      const wrapper = document.createElement('div')
      wrapper.className = 'mermaid-diagram-wrapper'
      wrapper.dataset.code = block
        .querySelector('pre code')!
        .textContent!.trim()
        .replace(/^(graph|flowchart)\s+(TD|TB)/, '$1 LR')
        .replace(/^(graph|flowchart)(?!\s+(LR|RL|TB|TD))/, '$1 LR')
      wrapper.innerHTML = '<div class="mermaid-content"></div>'
      block.replaceWith(wrapper)
    })

    const dark = document.documentElement.classList.contains('dark')
    const wrappers = document.querySelectorAll<HTMLElement>('.mermaid-diagram-wrapper')
    if (!wrappers.length) return
    mermaid_module ??= (await import('mermaid')).default

    mermaid_module.initialize({
      startOnLoad: false,
      theme: 'base',
      themeVariables: dark
        ? {
            background: '#161619',
            mainBkg: '#18181b',
            secondaryBkg: '#27272a',
            tertiaryBkg: '#161619',
            primaryColor: '#18181b',
            primaryTextColor: '#f4f4f5',
            primaryBorderColor: '#52525b',
            secondaryColor: '#27272a',
            tertiaryColor: '#161619',
            lineColor: '#a1a1aa',
            textColor: '#f4f4f5',
            edgeLabelBackground: '#18181b',
            clusterBkg: '#161619',
            clusterBorder: '#3f3f46'
          }
        : {
            background: '#fcfdfe',
            mainBkg: '#f6f7f8',
            secondaryBkg: '#eef1f3',
            tertiaryBkg: '#f6f7f8',
            primaryColor: '#f6f7f8',
            primaryTextColor: '#18181b',
            primaryBorderColor: '#71717a',
            secondaryColor: '#eef1f3',
            tertiaryColor: '#f6f7f8',
            lineColor: '#52525b',
            textColor: '#18181b',
            edgeLabelBackground: '#f6f7f8',
            clusterBkg: '#f8fafb',
            clusterBorder: '#d4d4d8'
          },
      flowchart: { htmlLabels: true, nodeSpacing: 30, rankSpacing: 40 }
    })

    for (const wrapper of wrappers) {
      if (wrapper.dataset.theme === String(dark)) continue
      const { svg } = await mermaid_module.render(
        `mermaid-svg-${render_id++}`,
        wrapper.dataset.code!
      )
      wrapper.querySelector('.mermaid-content')!.innerHTML = svg
      wrapper.dataset.theme = String(dark)
      wrapper.classList.add('is-rendered')
    }
  }

  document.addEventListener('astro:page-load', render_mermaid)
  new MutationObserver(render_mermaid).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  })
</script>

<style is:global>
  .mermaid-diagram-wrapper {
    margin: 1rem 0 0.5rem;
    padding: 0.75rem;
    border: 1px solid hsl(var(--border) / 0.6);
    border-radius: 0.75rem;
    background: transparent;
    text-align: center;
    max-width: 100%;
    overflow-x: auto;
    line-height: 1;
    min-height: 8rem;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      background-color 0.3s ease;
  }

  .mermaid-diagram-wrapper.is-rendered {
    min-height: 0;
  }

  .mermaid-content {
    display: flex;
    justify-content: center;
    align-items: center;
    width: max-content;
    min-width: 100%;
    padding: 0;
    margin: 0;
    line-height: 0;
  }

  .mermaid-content svg {
    width: auto !important;
    max-width: none !important;
    height: auto;
    display: block;
    margin: 0 auto;
    vertical-align: top;
  }

  .mermaid-content svg text {
    font-size: 12px !important;
    font-weight: normal !important;
  }
</style>
