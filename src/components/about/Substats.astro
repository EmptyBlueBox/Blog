---
interface SubstatsItem {
  platform: string
  icon: string
  link: string
  text: string
  id: string
  count?: number
}

const { stats } = Astro.props as { stats: SubstatsItem[] }
---

<substats-component
  class='border-border/60 grid grid-cols-1 gap-3 rounded-xl border bg-transparent p-2 sm:grid-cols-2 sm:p-3'
>
  {
    stats.map(({ link, platform, icon, text, id, count }) => (
      <a
        class='group text-muted-foreground hover:text-primary no-underline'
        href={link}
        target='_blank'
        rel='noopener noreferrer'
        data-platform={platform.toLowerCase()}
        data-id={id}
      >
        <div class='card-hover flex items-center gap-3 rounded-lg border border-transparent px-3 py-2'>
          <svg class='text-foreground group-hover:text-primary size-6 transition-colors'>
            <use href={`/icons/${icon}`} />
          </svg>
          <div class='text-foreground group-hover:text-primary flex-1 transition-colors'>
            {platform}
          </div>
          <div class='flex items-center gap-1.5' hidden={count === undefined}>
            <samp>{count}</samp>
            <span class='text-sm font-normal'>{text}</span>
          </div>
        </div>
      </a>
    ))
  }
</substats-component>

<script>
  class Substats extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll<HTMLElement>('[data-platform]').forEach(async (item) => {
        const { platform, id } = item.dataset
        const { count } = await (await fetch(`/api/followers?platform=${platform}&id=${id}`)).json()
        if (count === undefined) return
        const samp = item.querySelector('samp')!
        samp.textContent = count.toString()
        samp.parentElement!.hidden = false
      })
    }
  }

  customElements.define('substats-component', Substats)
</script>
