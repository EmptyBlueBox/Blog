---
import { cn } from '@/utils'

import Arrow from './Arrow.astro'

const { as: Tag = 'a', class: className, title, href, style = 'button', ...props } = Astro.props
const isTextArrow = style === 'ahead' || style === 'previous'
---

<Tag
  class={cn(
    'group/arrow inline-flex min-h-10 items-center gap-x-1 text-sm transition-colors',
    isTextArrow
      ? 'link-hover w-fit gap-2 font-medium text-foreground'
      : 'rounded-lg border border-border/60 px-3 py-2 text-muted-foreground hover:border-primary/50 hover:bg-primary/5 hover:text-primary',
    className,
    Tag === 'a' && !href && 'cursor-default',
    style === 'pill' && 'rounded-full',
    style === 'resource' &&
      'min-h-11 gap-2 rounded-[10px] border-border px-4 text-[0.9375rem] font-semibold whitespace-nowrap text-foreground [&_svg]:size-[18px] [&_svg]:shrink-0 max-[560px]:gap-1.5 max-[560px]:px-2.5 max-[560px]:text-sm max-[560px]:[&_svg]:size-4'
  )}
  href={href}
  {...props}
>
  <slot name='before'>{style === 'previous' && <Arrow class='rotate-180' />}</slot>
  <slot>{title && <span>{title}</span>}</slot>
  <slot name='after'>{style === 'ahead' && <Arrow />}</slot>
</Tag>
