---
import { cn } from '@/utils'

interface Props {
  class?: string
  title: string
}
const { class: className, title, ...props } = Astro.props
---

<collapse-component class='group/expand'>
  <div
    class={cn('my-4 rounded-xl border border-border/60 bg-transparent px-3 sm:px-4', className)}
    {...props}
  >
    <slot name='before' />
    <button
      type='button'
      aria-expanded='false'
      class='group/highlight expand-title bg-background/95 sticky top-0 z-20 flex w-full cursor-pointer items-center justify-between py-2 text-left sm:py-2.5'
    >
      <span class='group-hover/highlight:text-primary transition-colors'>{title}</span>
      <span class='expand-button'>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='16'
          height='16'
          viewBox='0 0 24 24'
          fill='none'
          stroke-width='2.5'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='stroke-muted-foreground group-hover/highlight:stroke-primary my-1 transition-[stroke,transform] duration-300 group-[.expanded]/expand:-rotate-90'
        >
          <line
            x1='5'
            y1='12'
            x2='19'
            y2='12'
            class='translate-x-1 scale-x-100 duration-300 ease-in-out group-[.expanded]/expand:translate-x-4 group-[.expanded]/expand:scale-x-0'
          ></line>
          <polyline
            points='12 5 19 12 12 19'
            class='translate-x-1 duration-300 ease-in-out group-[.expanded]/expand:translate-x-0'
          ></polyline>
        </svg>
      </span>
    </button>
    <div
      class='expand-content grid opacity-0 transition-[grid-template-rows,margin,opacity] duration-300 ease-in-out group-[.expanded]/expand:mb-3 group-[.expanded]/expand:opacity-100 sm:group-[.expanded]/expand:mb-4'
    >
      <div class='overflow-hidden'>
        <slot />
      </div>
    </div>
  </div>
</collapse-component>

<script>
  class Collapse extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('.expand-title')!
      button.addEventListener('click', () => {
        button.setAttribute('aria-expanded', String(this.classList.toggle('expanded')))
      })
    }
  }
  customElements.define('collapse-component', Collapse)
</script>

<style>
  .expand-content {
    grid-template-rows: 0fr;
  }
  .expanded .expand-content {
    grid-template-rows: 1fr;
  }
</style>
