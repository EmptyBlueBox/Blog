---
import { cn } from '@/utils'

const { class: className, size = 16 } = Astro.props
---

<svg
  xmlns='http://www.w3.org/2000/svg'
  width={size}
  height={size}
  viewBox='0 0 24 24'
  fill='none'
  stroke-width='2.5'
  stroke-linecap='round'
  stroke-linejoin='round'
  class={cn('stroke-current', className)}
>
  <line
    x1='5'
    y1='12'
    x2='19'
    y2='12'
    class='translate-x-4 scale-x-0 transition-transform duration-300 ease-in-out group-hover/arrow:translate-x-1 group-hover/arrow:scale-x-100'
  ></line>
  <polyline
    points='12 5 19 12 12 19'
    class='transition-transform duration-300 ease-in-out group-hover/arrow:translate-x-1'
  ></polyline>
</svg>
