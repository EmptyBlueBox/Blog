---
import { cn } from '@/utils'

const { class: className, commentPath, hideComment, path, ...props } = Astro.props
---

<div data-page-info class={cn('text-muted-foreground text-sm', className)} {...props}>
  <span class='waline-pageview-count' aria-live='polite' data-path={path}>—</span> views
  {
    !hideComment && (
      <a href='#waline'>
        |{' '}
        <span class='waline-comment-count' aria-live='polite' data-path={commentPath ?? path}>
          —
        </span>{' '}
        comments
      </a>
    )
  }
</div>
