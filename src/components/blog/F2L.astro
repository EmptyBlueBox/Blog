type Props = { lang: 'zh' | 'en' } & (
  { ids: string[]; example?: never } | { example: keyof typeof steps | 'notation'; ids?: never }
)

const { ids, example, lang } = Astro.props
const mirrorLabel = lang === 'zh' ? '镜像' : 'Mirror'
const prefix = 'https://cdn.lyt0112.com/posts/f2l-nonstandard/images/'
const directions: Record<string, string> =
  lang === 'zh'
    ? { U: '上', D: '下', F: '前', B: '后', R: '右', L: '左' }
    : { U: 'up', D: 'down', F: 'front', B: 'back', R: 'right', L: 'left' }
const figure = (id: string, label = id) => {
  const c = cases[id]
  const caption =
    lang === 'zh'
      ? `角 ${c.corner} 白朝${directions[c.white]}；棱 ${c.edge} 蓝朝${directions[c.blue]}`
      : `Corner ${c.corner}, white ${directions[c.white]}; edge ${c.edge}, blue ${directions[c.blue]}`
  return {
    src: prefix + c.image,
    width: 820,
    height: 410,
    id: id.toLowerCase(),
    alt: caption,
    caption: `${label} · ${caption}`,
    algorithm: c.algorithm
  }
}
---

{
  example === 'notation' ? (
    <TutorialImages
      images={[
        {
          src: prefix + 'a1980c3d9c98/notation.svg',
          alt: 'U D F B R L · FR',
          width: 1000,
          height: 440
        }
      ]}
      maxWidth='100%'
    />
  ) : example ? (
    <TutorialImages
      columns={2}
      images={steps[example].map(([image, algorithm], i) => ({
        src: prefix + image,
        width: 820,
        height: 410,
        alt: `${example} · ${i}`,
        caption: `${example} · ${i === 0 ? (lang === 'zh' ? '初始状态' : 'Start') : i}`,
        algorithm
      }))}
    />
  ) : (
    <div class='f2l-cases'>
      {ids!.map((id) => (
        <div class='f2l-case'>
          <TutorialImages images={[figure(id)]} maxWidth='100%' />
          {cases[id + 'm'] && (
            <details>
              <summary>{mirrorLabel}</summary>
              <TutorialImages
                images={[figure(id + 'm', `${id} · ${mirrorLabel}`)]}
                maxWidth='100%'
              />
            </details>
          )}
        </div>
      ))}
    </div>
  )
}

<style>
  .f2l-cases {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 1.5rem 1rem;
    margin-block: 1.5rem;
  }

  .f2l-case {
    min-width: 0;
  }

  .f2l-case :global(.tutorial-images) {
    margin: 0;
  }

  details {
    margin-block-start: 0.5rem;
  }

  summary {
    width: fit-content;
    cursor: pointer;
    font-size: 0.875rem;
  }

  details[open] > summary {
    margin-block-end: 1rem;
  }

  @media (max-width: 639px) {
    .f2l-cases {
      grid-template-columns: 1fr;
    }
  }
</style>
