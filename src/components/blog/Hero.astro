---
import { cdnImage } from '@/data/cdn'
import { render, type CollectionEntry } from 'astro:content'

import LanguageNav from '@/components/blog/LanguageNav.astro'
import CDNImage from '@/components/CDNImage.astro'
import PageInfo from '@/components/pages/PageInfo.astro'
import { FormattedDate } from '@/components/user'

interface LanguageOption {
  href: string
  label: string
  language: string
  isActive: boolean
}

interface Props {
  content: CollectionEntry<'post'>
  translations?: LanguageOption[]
  commentPath: string
}

const { content, translations = [], commentPath } = Astro.props
const { data } = content
const image = data.heroImage ? cdnImage(data.heroImage.asset) : undefined

const { remarkPluginFrontmatter } = await render(content)
---

<header class='border-border/70 border-b pb-5'>
  <div
    class='text-muted-foreground flex flex-wrap items-center justify-between gap-x-3 gap-y-4 text-[13px]'
  >
    <div class='flex items-baseline gap-2'>
      <FormattedDate class='font-sans' date={data.updatedDate ?? data.publishDate} />
      <span aria-hidden='true'>·</span>
      <span>{remarkPluginFrontmatter.minutesRead}</span>
    </div>
    {translations.length > 0 && <LanguageNav label='Article language' options={translations} />}
  </div>
  <h1
    class='text-foreground mt-4 text-[26px] leading-tight font-semibold tracking-[-0.02em] text-balance sm:text-[32px]'
  >
    {data.draft && <span class='text-red-500'>(Draft) </span>}{data.title}
  </h1>
  <p class='text-muted-foreground mt-2.5 text-[15px] leading-relaxed italic sm:text-base'>
    {data.description}
  </p>
  {!data.draft && <PageInfo class='mt-3 text-[13px] italic' path={commentPath} />}
</header>

{
  data.heroImage && image && (
    <CDNImage
      class='border-border/50 mt-6 block max-h-[min(46svh,440px)] w-auto max-w-full rounded-lg border'
      alt={data.heroImage.alt || data.description}
      fetchpriority='high'
      loading='eager'
      asset={data.heroImage.asset}
      sizes={`min(100vw - 2rem, 48rem, ${image.width}px, ${(46 * image.width) / image.height}svh, ${(440 * image.width) / image.height}px)`}
      data-transparent
    />
  )
}

<style>
  :global(img[data-transparent]) {
    background-color: transparent;
  }
</style>
