---
import { render, type CollectionEntry } from 'astro:content'
import type { HTMLTag, Polymorphic } from 'astro/types'

import CDNImage from '@/components/CDNImage.astro'
import { Arrow, Button, FormattedDate } from '@/components/user'
import { cn } from '@/utils'

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  post: CollectionEntry<'post'>
  detailed?: boolean
  class?: string
  languages?: string[]
}

const { as: Tag = 'div', post, detailed = false, class: className, languages } = Astro.props
const { data, id } = post
const postDate = data.updatedDate ?? data.publishDate
const language_labels: string[] = (languages ?? [data.language.slice(0, 2)]).map(
  (language: string) => language.toUpperCase()
)

const { remarkPluginFrontmatter } = await render(post)
---

<li
  class={cn(
    'group/card card card-hover relative flex flex-col',
    detailed && 'overflow-hidden py-4 sm:py-5',
    className
  )}
>
  <a
    class={cn('group/arrow flex w-full flex-col', !detailed && 'sm:flex-row sm:gap-x-4')}
    href={`/blog/${id}`}
  >
    {
      detailed && data.heroImage && (
        <CDNImage
          asset={data.heroImage.asset}
          sizes='(max-width: 639px) 100vw, (max-width: 767px) 60vw, 480px'
          alt={data.heroImage.alt || data.description}
          class='cover-image pointer-events-none absolute end-0 top-0 z-0 h-full w-full object-cover opacity-45 transition-opacity duration-300 group-hover/card:opacity-60 sm:w-1/2'
          loading='lazy'
        />
      )
    }

    <div
      class={cn(
        'text-muted-foreground z-10 flex items-center gap-2 py-1 text-xs whitespace-nowrap',
        !detailed && 'sm:min-w-44'
      )}
    >
      <FormattedDate class='min-w-[95px]' date={postDate} />
      <span class='opacity-40' aria-hidden='true'>·</span>
      <span class='flex items-center gap-1.5 font-mono'>
        {
          language_labels.map((language, index) => (
            <>
              {index > 0 && (
                <span class='opacity-40' aria-hidden='true'>
                  ·
                </span>
              )}
              <span>{language}</span>
            </>
          ))
        }
      </span>
    </div>

    <Tag class='z-10 flex-grow'>
      <!-- title -->
      <div class='flex justify-between font-medium'>
        <div>
          {data.draft && <span class='text-red-500'>(Draft) </span>}
          {data.title}
        </div>
        <Arrow class='stroke-muted-foreground group-hover/arrow:stroke-primary my-1' />
      </div>
      {
        detailed && (
          <>
            {/* desc */}
            <p
              class={cn(
                'text-muted-foreground line-clamp-2 pt-1 text-sm sm:line-clamp-3',
                data.heroImage && 'sm:me-24'
              )}
            >
              {data.description}
            </p>
            <div class='text-muted-foreground flex items-center gap-2 py-1.5 text-sm leading-4 italic sm:py-3'>
              {/* reading time */}
              <span class='flex items-center gap-1'>
                <svg class='size-4'>
                  <use href='/icons/ui.svg#mingcute-time-line' />
                </svg>
                {remarkPluginFrontmatter.minutesRead}
              </span>
            </div>
          </>
        )
      }
    </Tag>
  </a>
  <!-- tags -->
  {
    detailed && data.tags && (
      <ul class='text-muted-foreground relative z-10 mt-1 flex flex-wrap gap-2'>
        {data.tags.map((tag: string) => (
          <li>
            <Button
              title={tag}
              href={`/tags/${encodeURIComponent(tag)}`}
              class='min-h-8 rounded-lg px-3 py-1'
            />
          </li>
        ))}
      </ul>
    )
  }
</li>

<style>
  .cover-image {
    mask-image: linear-gradient(to right, transparent, black 70%);
  }
</style>
