---
import { Button } from '@/components/user'

interface Props {
  options: {
    href: string
    label: string
    isActive: boolean
  }[]
  label: string
  class?: string
}

const { options, label, class: className } = Astro.props
---

<nav class:list={['flex flex-wrap gap-2 not-italic', className]} aria-label={label}>
  {
    options.map((option) => (
      <Button
        title={option.label}
        href={option.href}
        class={`min-h-8 rounded-lg px-4 py-1 font-normal tracking-normal ${
          option.isActive
            ? 'border-primary/70 bg-primary/10 text-primary hover:border-primary/70 hover:bg-primary/15'
            : ''
        }`}
        aria-current={option.isActive ? 'page' : undefined}
      />
    ))
  }
</nav>
