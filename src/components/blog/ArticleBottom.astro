---
import type { CollectionEntry } from 'astro:content'

import { cn } from '@/utils'
import { get_all_posts, sort_posts } from '@/utils/collections'

type Props = {
  content: CollectionEntry<'post'>
  class?: string
}

const { content, class: className } = Astro.props
const items = sort_posts(
  (await get_all_posts()).filter(
    (post) => !post.data.draft && post.data.language === content.data.language
  )
)
const index = items.findIndex((post) => post.id === content.id)
const prev = items[index - 1]
const next = items[index + 1]
---

<div class={cn('grid grid-cols-1 gap-2 sm:gap-4 sm:grid-cols-2', className)}>
  <div>
    {
      prev && (
        <a
          href={`/blog/${prev.id}`}
          class='group border-border/60 hover:border-border hover:bg-muted/50 flex items-center gap-3 rounded-xl border bg-transparent px-4 py-2 no-underline transition-[background-color,border-color] duration-300 sm:py-4'
        >
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='20'
            height='20'
            viewBox='0 0 24 24'
            fill='none'
            stroke-width='2.5'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='stroke-muted-foreground group-hover:stroke-primary rotate-180 transition-colors'
          >
            <line
              x1='5'
              y1='12'
              x2='19'
              y2='12'
              class='translate-x-4 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
            />
            <polyline
              points='12 5 19 12 12 19'
              class='translate-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-1'
            />
          </svg>
          <div class='flex max-w-[80%] grow flex-col gap-0.5 sm:gap-1.5'>
            <div class='text-muted-foreground text-sm font-normal uppercase'>Prev</div>
            <div class='truncate font-medium whitespace-nowrap transition-colors'>
              {prev.data.title}
            </div>
          </div>
        </a>
      )
    }
  </div>

  <div>
    {
      next && (
        <a
          href={`/blog/${next.id}`}
          class='group border-border/60 hover:border-border hover:bg-muted/50 flex items-center justify-end gap-3 rounded-xl border bg-transparent px-4 py-2 text-right no-underline transition-[background-color,border-color] duration-300 sm:py-4'
        >
          <div class='flex max-w-[80%] grow flex-col gap-0.5 sm:gap-1.5'>
            <div class='text-muted-foreground text-sm font-normal uppercase'>Next</div>
            <div class='truncate font-medium whitespace-nowrap transition-colors'>
              {next.data.title}
            </div>
          </div>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='20'
            height='20'
            viewBox='0 0 24 24'
            fill='none'
            stroke-width='2.5'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='stroke-muted-foreground group-hover:stroke-primary transition-colors'
          >
            <line
              x1='5'
              y1='12'
              x2='19'
              y2='12'
              class='translate-x-4 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100'
            />
            <polyline
              points='12 5 19 12 12 19'
              class='translate-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-1'
            />
          </svg>
        </a>
      )
    }
  </div>
</div>
