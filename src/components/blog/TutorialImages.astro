---
interface Props {
  images: {
    src: string
    alt: string
    width: number
    height: number
    diagramHeight?: number
    caption?: string
    algorithm?: string
    note?: string
    id?: string
  }[]
  columns?: number
  maxWidth?: string
}

const {
  images,
  columns = Math.min(images.length, 2),
  maxWidth = columns === 1 ? '30rem' : '100%'
} = Astro.props
---

<div class='tutorial-images' style={`--columns: ${columns}; max-width: ${maxWidth}`}>
  {
    images.map(({ caption, algorithm, note, id, diagramHeight, ...image }) => (
      <figure id={id}>
        {caption && <figcaption>{caption}</figcaption>}
        <div
          class:list={['tutorial-diagram', { cropped: diagramHeight !== undefined }]}
          style={diagramHeight ? `aspect-ratio: ${image.width} / ${diagramHeight}` : undefined}
        >
          <img {...image} loading='lazy' decoding='async' class='zoomable' />
        </div>
        {algorithm && (
          <p class='tutorial-algorithm'>
            <code>{algorithm}</code>
          </p>
        )}
        {note && <p class='tutorial-note'>{note}</p>}
      </figure>
    ))
  }
</div>

<style>
  .tutorial-images {
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
    margin-inline: auto;
  }

  .tutorial-images img {
    width: 100%;
    height: auto;
    margin: 0;
    border-radius: 0.5rem;
  }

  .tutorial-diagram {
    overflow: hidden;
    border-radius: 0.5rem;
  }

  .tutorial-diagram.cropped {
    position: relative;
  }

  .tutorial-diagram.cropped img {
    position: absolute;
    top: 0;
    left: 0;
  }

  .tutorial-images figure {
    min-width: 0;
    margin: 0;
  }

  .tutorial-images figcaption {
    margin: 0 0 0.5rem;
    color: inherit;
    font-size: inherit;
    font-weight: 600;
  }

  .tutorial-images .tutorial-algorithm {
    margin: 0.75rem 0 0;
    line-height: 1.8;
  }

  .tutorial-images .tutorial-algorithm code {
    border: 0 !important;
    background: transparent !important;
    padding: 0 !important;
    color: inherit !important;
    font-size: 1rem;
  }

  .tutorial-images .tutorial-note {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  @media (max-width: 639px) {
    .tutorial-images {
      grid-template-columns: 1fr;
    }
  }
</style>
