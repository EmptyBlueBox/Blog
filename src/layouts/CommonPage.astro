---
import type { MarkdownHeading } from 'astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import type { SiteMeta } from '@/types'

import MobileTOC from '@/components/pages/MobileTOC.astro'
import PageInfo from '@/components/pages/PageInfo.astro'
import TOC from '@/components/pages/TOC.astro'
import { cn } from '@/utils'
import { integrationConfig } from '@/site-config'

interface Props {
  title: string
  meta?: Partial<SiteMeta>
  headings?: MarkdownHeading[]
  info?:
    | string
    | {
        slug: string
        hideComment?: boolean
      }
}

const { title, meta, headings, info, ...props } = Astro.props
const has_toc = !!headings?.length
---

<PageLayout meta={{ title, ...meta }} {...props}>
  <div class={cn('w-full', !has_toc && 'mx-auto md:w-4/5 lg:w-5/6')}>
    <div class='mt-6 w-full items-start gap-x-10 sm:mt-8 md:flex'>
      {
        has_toc && (
          <TOC
            class='top-24 z-10 min-w-40 basis-60 max-md:hidden md:sticky md:order-2'
            {headings}
          />
        )
      }
      <article class='min-w-0 grow'>
        <div id='content-header' class='w-full'>
          <h1 class='text-2xl font-medium tracking-tight sm:mb-2 sm:text-3xl'>
            {title}
          </h1>
          {
            info && (
              <PageInfo
                path={typeof info === 'string' ? info : info.slug}
                hideComment={
                  typeof info === 'object' && info.hideComment ? info.hideComment : false
                }
                class='italic'
              />
            )
          }
        </div>
        <div
          id='content'
          class={cn(
            'mx-auto mt-8 w-full',
            integrationConfig.typography.class,
            has_toc ? 'max-w-[65ch]' : 'max-w-none'
          )}
        >
          <slot />
        </div>
        <div class={cn('text-muted-foreground mx-auto mt-8 w-full', has_toc && 'max-w-[65ch]')}>
          <slot name='bottom' />
        </div>
      </article>
    </div>
    {has_toc && <MobileTOC headings={headings} />}
  </div>
</PageLayout>
