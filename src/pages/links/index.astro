---
import { links } from '@/data/links'
import { extendedSocialLinks } from '@/data/social_links'
import PageLayout from '@/layouts/CommonPage.astro'

import SocialLinksRow from '@/components/about/SocialLinksRow.astro'
import Substats from '@/components/about/Substats.astro'
import { Comment } from '@/components/advanced'
import FriendList from '@/components/links/FriendList.astro'
import Sponsors from '@/components/projects/Sponsors.astro'
import { Collapse, InfoCard, Timeline } from '@/components/user'
import { integrationConfig } from '@/site-config'

const headings = [
  {
    depth: 2,
    slug: 'my-links',
    text: 'My Social Links'
  },
  {
    depth: 2,
    slug: 'friend-links',
    text: 'Friend Links'
  },
  {
    depth: 2,
    slug: 'this-site',
    text: 'Dependencies of This Site'
  },
  {
    depth: 2,
    slug: 'sponsorship',
    text: 'Sponsorship'
  }
]

const { friends } = links
const linksConfig = integrationConfig.links
const interactive_card_class =
  'rounded-lg border-transparent bg-transparent hover:border-border hover:bg-muted/50 transition-[background-color,border-color]'
const siteDependencies = [
  [
    'Website Source Code',
    'GitHub',
    'https://github.com/EmptyBlueBox/Blog',
    'size-5 text-blue-500',
    'mingcute-github-line'
  ],
  ['Framework', 'Astro', 'https://astro.build/', 'size-5 text-orange-500', 'mingcute-code-line'],
  [
    'Original Theme',
    'Astro Theme Pure',
    'https://github.com/cworld1/astro-theme-pure',
    'size-5 text-pink-500',
    'mingcute-palette-line'
  ],
  [
    'Hosting',
    'Vercel',
    'https://vercel.com/',
    'text-muted-foreground size-5',
    'mingcute-cloud-line'
  ],
  [
    'CI/CD',
    'Vercel Workflow',
    'https://vercel.com/workflow',
    'size-5 text-blue-500',
    'mingcute-git-merge-line'
  ],
  [
    'CDN',
    'Doge Cloud',
    'https://console.dogecloud.com/',
    'size-5 text-green-500',
    'mingcute-server-line'
  ],
  [
    'Comment System',
    'Waline',
    'https://waline.js.org/',
    'size-5 text-cyan-500',
    'mingcute-message-line'
  ],
  [
    'Visits and Comments Database',
    'Supabase',
    'https://supabase.com/',
    'size-5 text-cyan-500',
    'mingcute-message-line'
  ]
]

const friendLinkFields = [
  ['name', 'Name', 'Click to copy name', 'size-5 text-blue-500', 'mingcute-user-line'],
  ['url', 'Website', 'Click to copy website URL', 'size-5 text-purple-500', 'mingcute-world-line'],
  ['desc', 'Motto', 'Click to copy motto', 'size-5 text-green-500', 'mingcute-quote-line'],
  ['avatar', 'Avatar', 'Click to copy avatar URL', 'size-5 text-orange-500', 'mingcute-image-line']
] as const
---

<PageLayout title='Links' {headings} info='/links'>
  <h2 id='my-links'>My Social Links</h2>
  <SocialLinksRow links={extendedSocialLinks} />

  <p></p>

  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'social.svg#mingcute-github-line',
        link: 'https://github.com/EmptyBlueBox',
        text: 'followers',
        api: 'github/EmptyBlueBox'
      },
      {
        platform: 'X',
        icon: 'social.svg#mingcute-x-line',
        link: 'https://x.com/YutongLiang_',
        text: 'followers',
        api: 'x/YutongLiang_'
      },
      {
        platform: 'Bilibili',
        icon: 'social.svg#ri-bilibili-line',
        color: '#fe7398',
        link: 'https://space.bilibili.com/214390234',
        text: 'fans',
        api: '214390234'
      },
      {
        platform: 'Zhihu',
        icon: 'social.svg#ri-zhihu-line',
        color: '#0084ff',
        // link: 'https://www.zhihu.com/people/tardis-77',
        text: 'followers',
        api: 'zhihu/tardis-77'
      }
    ]}
  />

  <p></p>
  <h2 id='friend-links'>Friend Links</h2>
  <p>Friend links are sorted randomly ~</p>
  <FriendList list={friends[0]} />

  <Collapse title='History Book'>
    <Timeline events={linksConfig.logbook} />
  </Collapse>
  <h3>Apply for a Friend Link</h3>
  <div
    class='border-border/60 grid grid-cols-1 gap-3 rounded-xl border bg-transparent p-2 sm:grid-cols-2 sm:p-3'
  >
    {
      friendLinkFields.map(([key, label, title, color, icon]) => (
        <button
          class='copy-btn group text-muted-foreground text-left no-underline'
          data-clipboard-target={`#link-${key}`}
          title={title}
        >
          <InfoCard class:list={[interactive_card_class, 'flex items-center gap-2']} interactive>
            <svg class={color}>
              <use href={`/icons/copyright-sponsor.svg#${icon}`} />
            </svg>
            <div class='text-foreground group-hover:text-primary flex-1 font-medium transition-colors'>
              {label}
            </div>
            <div class='flex items-center gap-1.5'>
              <span id={`link-${key}`} class='text-sm break-all'>
                {linksConfig.applyTip[key]}
              </span>
            </div>
          </InfoCard>
        </button>
      ))
    }
  </div>

  <ul>
    <li>Add this site as one of your friend links.</li>
    <li>Ensure your site is activated.</li>
    <li>
      Contact me via my <a
        href='mailto:lyt0112@outlook.com'
        target='_blank'
        rel='noopener noreferrer'>email</a
      > or leave a comment on this page!
    </li>
  </ul>

  <h2 id='this-site'>Dependencies of This Site</h2>
  <div
    class='border-border/60 grid grid-cols-1 gap-3 rounded-xl border bg-transparent p-2 sm:grid-cols-2 sm:p-3'
  >
    {
      siteDependencies.map(([label, name, href, color, icon]) => (
        <a
          class='group text-muted-foreground no-underline'
          href={href}
          target='_blank'
          rel='noopener noreferrer'
        >
          <InfoCard class:list={[interactive_card_class, 'flex items-center gap-2']} interactive>
            <svg class={color}>
              <use href={`/icons/copyright-sponsor.svg#${icon}`} />
            </svg>
            <div class='text-foreground group-hover:text-primary flex-1 font-medium transition-colors'>
              {label}
            </div>
            <div class='flex items-center gap-1.5'>
              <span class='text-sm'>{name}</span>
              <svg class='text-muted-foreground size-4 transition-transform group-hover:scale-110'>
                <use href='/icons/copyright-sponsor.svg#mingcute-external-link-line' />
              </svg>
            </div>
          </InfoCard>
        </a>
      ))
    }
  </div>
  <h2 id='sponsorship'>Sponsorship</h2>

  <p>Many thanks to the following sponsors!</p>
  <Sponsors
    sponsors={[
      { name: '君', amount: 'CNY 100.00', date: '2025-02-05' },
      { name: 'Jaspeco.sea', amount: 'CNY 20.00', date: '2024-11-14' }
    ]}
  />

  <Comment slot='bottom' />
</PageLayout>

<script>
  import { showToast } from '@/utils/toast'

  document.addEventListener('astro:page-load', () => {
    const copyButtons = document.querySelectorAll('.copy-btn')

    copyButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-clipboard-target')
        if (targetId) {
          const targetElement = document.querySelector(targetId)
          if (targetElement) {
            navigator.clipboard.writeText(targetElement.textContent || '').then(
              () => {
                showToast({ message: 'Copied to clipboard!' })
              },
              (err) => {
                console.error('Could not copy text: ', err)
                showToast({ message: 'Failed to copy' })
              }
            )
          }
        }
      })
    })
  })
</script>
