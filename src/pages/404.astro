---
import PageLayout from '@/layouts/BaseLayout.astro'

import { Button } from '@/components/user'

const meta = {
  description: 'Page not found',
  title: '404 - Page Not Found'
}
---

<PageLayout {meta}>
  <div class='px-4 py-16 text-center sm:px-6 lg:px-8'>
    <div class='mx-auto max-w-md'>
      <h1 class='text-muted-foreground mb-6 text-7xl font-semibold tracking-tight sm:text-8xl'>
        404
      </h1>

      <h2 class='mb-4 text-2xl font-medium tracking-tight'>Page Not Found</h2>
      <p class='text-muted-foreground'>
        The page you are looking for might have been removed, had its name changed, or is
        temporarily unavailable.
      </p>
      <p class='text-muted-foreground mt-6'>
        If you believe this is an error, please contact my <a href='mailto:lyt0112@outlook.com'
          >email</a
        >.
      </p>
      <div class='mt-8 flex justify-center'>
        <Button title='Return to Home' href='/' style='ahead' />
      </div>
    </div>
  </div>
</PageLayout>
