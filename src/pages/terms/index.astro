---
import PageLayout from '@/layouts/BaseLayout.astro'

import { terms } from '@/site-config'

const meta = {
  title: 'Site Policy',
  description: 'Site Policy Documentation'
}
---

<PageLayout {meta}>
  <div class='w-full'>
    <h1
      id='content-header'
      class='mt-6 mb-8 text-2xl font-medium tracking-tight sm:mt-8 sm:text-3xl'
    >
      Site Policy
    </h1>

    <ul class='ms-5 flex list-disc flex-col gap-y-1'>
      {
        terms.list.map((item) => (
          <li>
            <a href={item.link} class='text-foreground block'>
              {item.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</PageLayout>
