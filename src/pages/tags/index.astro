---
import PageLayout from '@/layouts/BaseLayout.astro'

import { Button } from '@/components/user'
import { get_canonical_posts, get_tag_counts } from '@/utils/collections'

const allPosts = await get_canonical_posts()
const allTags = get_tag_counts(allPosts)

const meta = {
  description: "A list of all the topics I've written about in my posts",
  title: 'All Tags'
}
---

<PageLayout {meta}>
  <div class='w-full'>
    <h1 class='mt-6 mb-8 text-2xl font-medium tracking-tight sm:mt-8 sm:text-3xl'>Tags</h1>

    {
      allTags.length > 0 ? (
        <ul class='flex flex-wrap gap-4'>
          {allTags.map(([tag, val]) => (
            <li>
              <Button
                href={`/tags/${encodeURIComponent(tag)}`}
                style='pill'
                class:list={[
                  'items-start gap-x-1 rounded-full',
                  val > 2 ? 'px-3.5 py-1 text-xl' : val > 1 && 'text-lg'
                ]}
              >
                {tag}
                <span class={val > 2 ? 'text-base' : 'text-xs'}>{val}</span>
              </Button>
            </li>
          ))}
        </ul>
      ) : (
        <p>Any tag yet.</p>
      )
    }
  </div>
</PageLayout>
