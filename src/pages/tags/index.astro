---
import PageLayout from '@/layouts/BaseLayout.astro'

import { Button } from '@/components/user'
import { get_canonical_posts, get_tag_counts } from '@/utils/collections'

const allPosts = await get_canonical_posts()
const allTags = get_tag_counts(allPosts)

const meta = {
  description: "A list of all the topics I've written about in my posts",
  title: 'All Tags'
}
---

<PageLayout {meta}>
  <div class='w-full'>
    <h1 class='mt-6 mb-8 text-2xl font-medium tracking-tight sm:mt-8 sm:text-3xl'>Tags</h1>

    {
      allTags.length > 0 ? (
        <ul class='text-muted-foreground flex flex-wrap gap-2'>
          {allTags.map(([tag, count]) => (
            <li>
              <Button
                href={`/tags/${encodeURIComponent(tag)}`}
                class='min-h-8 gap-2.5 rounded-lg px-3 py-1'
                aria-label={`${tag}: ${count} ${count === 1 ? 'post' : 'posts'}`}
              >
                <span>{tag}</span>
                <span
                  aria-hidden='true'
                  class='border-border/70 border-s ps-2.5 text-xs tabular-nums opacity-70'
                >
                  {count}
                </span>
              </Button>
            </li>
          ))}
        </ul>
      ) : (
        <p>Any tag yet.</p>
      )
    }
  </div>
</PageLayout>
