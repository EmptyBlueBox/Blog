---
import type { GetStaticPaths } from 'astro'
import PageLayout from '@/layouts/BaseLayout.astro'

import PostPreview from '@/components/blog/PostPreview.astro'
import { Button } from '@/components/user'
import {
  get_all_posts,
  get_entry_languages,
  get_tag_counts,
  normalize_language,
  select_canonical_posts,
  sort_posts
} from '@/utils/collections'
import { siteConfig } from '@/site-config'

export const getStaticPaths = (async ({ paginate }) => {
  const all_posts = await get_all_posts()
  const filters = [
    { id: 'all', posts: select_canonical_posts(all_posts) },
    {
      id: 'en',
      posts: all_posts.filter((post) => normalize_language(post.data.language) === 'en')
    },
    {
      id: 'zh',
      posts: all_posts.filter((post) => normalize_language(post.data.language) === 'zh')
    }
  ] as const

  return filters.flatMap(({ id, posts }) =>
    paginate(sort_posts(posts), {
      pageSize: siteConfig.blog.pageSize,
      props: {
        filter: id,
        uniqueTags: get_tag_counts(posts)
          .slice(0, 8)
          .map(([tag]) => tag)
      }
    }).map(({ params, props }) => ({
      params: {
        page: id === 'all' ? params.page : params.page ? `${id}/${params.page}` : id
      },
      props
    }))
  )
}) satisfies GetStaticPaths

const { page, uniqueTags, filter } = Astro.props
const all_posts = await get_all_posts()

const meta = {
  description: 'Posts and archives from Yutong Liang.',
  title: filter === 'all' ? 'Blog' : filter === 'en' ? 'English Writing' : '中文文章'
}

const paginationProps = {
  ...(page.currentPage > 1 && {
    prevUrl: {
      text: `Previous Page`,
      url:
        filter === 'all'
          ? page.currentPage === 2
            ? '/blog'
            : `/blog/${page.currentPage - 1}`
          : page.currentPage === 2
            ? `/blog/${filter}`
            : `/blog/${filter}/${page.currentPage - 1}`
    }
  }),
  ...(page.currentPage < page.lastPage && {
    nextUrl: {
      text: `Next Page`,
      url:
        filter === 'all'
          ? `/blog/${page.currentPage + 1}`
          : `/blog/${filter}/${page.currentPage + 1}`
    }
  })
}

const filters = [
  { id: 'all', label: 'All', href: '/blog' },
  { id: 'en', label: 'English', href: '/blog/en' },
  { id: 'zh', label: 'Chinese', href: '/blog/zh' }
] as const
---

<PageLayout {meta}>
  <div class='w-full'>
    <h1 class='mt-6 mb-4 text-2xl font-medium tracking-tight sm:mt-8 sm:mb-7 sm:text-3xl'>Blog</h1>
    <nav class='mb-4 flex flex-wrap gap-2 sm:mb-7' aria-label='Blog language'>
      {
        filters.map((item) => (
          <Button
            title={item.label}
            href={item.href}
            class={`min-h-8 rounded-lg px-4 py-1 ${filter === item.id ? 'border-primary/70 bg-primary/10 text-primary' : ''}`}
            aria-current={filter === item.id ? 'page' : undefined}
          />
        ))
      }
    </nav>

    {
      page.data.length === 0 ? (
        <p>No posts yet.</p>
      ) : (
        <>
          <div class='grid gap-y-16 md:grid-cols-[3fr_1fr] md:gap-x-8'>
            <section aria-label='Blog posts list'>
              <div class='mb-3 flex items-center justify-between text-sm sm:mb-5'>
                <span class='text-muted-foreground'>
                  Page {page.currentPage} - Showing {page.data.length} of {page.total}
                  {page.total === 1 ? ' post' : ' posts'}
                </span>
                <Button
                  title='View All Posts'
                  class='ms-auto hidden sm:inline-flex'
                  href='/archives'
                  style='ahead'
                />
              </div>
              <ul class='flex flex-col gap-y-3 text-start sm:gap-y-4'>
                {page.data.map((p) => (
                  <PostPreview
                    as='h2'
                    post={p}
                    detailed
                    languages={filter === 'all' ? get_entry_languages(p, all_posts) : [filter]}
                  />
                ))}
              </ul>
              {(paginationProps.prevUrl || paginationProps.nextUrl) && (
                <nav class='mt-4 flex items-center gap-x-4 sm:mt-6'>
                  {paginationProps.prevUrl && (
                    <Button
                      title={paginationProps.prevUrl.text}
                      href={paginationProps.prevUrl.url}
                      style='previous'
                      class='me-auto'
                    />
                  )}
                  {paginationProps.nextUrl && (
                    <Button
                      title={paginationProps.nextUrl.text}
                      href={paginationProps.nextUrl.url}
                      style='ahead'
                      class='ms-auto'
                    />
                  )}
                </nav>
              )}
            </section>
            {!!uniqueTags.length && (
              <aside id='sidebar'>
                <h2 class='mb-4 flex items-center text-lg font-semibold'>
                  <svg class='me-2 size-6'>
                    <use href='/icons/ui.svg#mingcute-tag-2-line' />
                  </svg>
                  Tags
                </h2>
                <ul class='text-muted-foreground flex flex-wrap gap-2'>
                  {uniqueTags.map((tag) => (
                    <li>
                      <Button
                        title={tag}
                        href={`/tags/${encodeURIComponent(tag)}`}
                        class='min-h-8 rounded-lg px-3 py-1'
                      />
                    </li>
                  ))}
                </ul>
                <div class='mt-4 block sm:text-end'>
                  <Button title='All Topics' href='/tags' style='ahead' />
                </div>
              </aside>
            )}
          </div>
        </>
      )
    }
  </div>
</PageLayout>
