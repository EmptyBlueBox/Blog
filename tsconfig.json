{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "declaration": true,
    "strictNullChecks": true,
    "allowJs": true,
    "baseUrl": ".",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/site-config": [
        "src/site.config.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    ".vscode",
    "dist",
    ".vercel",
    "notes",
    "public/scripts"
  ]
}
